{
  "name": "sulcata-ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/licenses.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "api:generate": "openapi-typescript openapi.json -o src/api.generated.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "codemirror": "5.65.21",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sql-formatter": "15.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/codemirror": "^5.60.16",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
